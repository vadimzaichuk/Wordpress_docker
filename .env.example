# Copy this file to .env and adjust the values for your server:
#   Linux/macOS: cp .env.example .env
#   Windows:     Copy-Item .env.example .env
#
# The .env file is not committed to git (see .gitignore).

# ---------------------------------------------------------------------------
# Server network settings
# ---------------------------------------------------------------------------
# Public IP address or domain name of the server where the stack runs.
SERVER_HOST=YOUR_SERVER_IP_OR_DOMAIN

# Port on the host used for WordPress (http://SERVER_HOST:WORDPRESS_PORT).
# Default 8080 avoids privileged port issues. Use 80 if the port is free.
WORDPRESS_PORT=8080

# Port on the host used for phpMyAdmin (http://SERVER_HOST:PHPMYADMIN_PORT).
PHPMYADMIN_PORT=8081

# Full public URL of the site. Keep it in sync with SERVER_HOST and WORDPRESS_PORT.
# Examples: http://203.0.113.10:8080  http://example.com  https://example.com
# Do not add a trailing slash.
WORDPRESS_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080

# ---------------------------------------------------------------------------
# Database credentials
# ---------------------------------------------------------------------------
# Database name created on first start.
DB_NAME=wordpress

# Database user (also the default phpMyAdmin login).
DB_USER=master

# Password for DB_USER.
DB_PASSWORD=Qwerty123

# MariaDB root password.
DB_ROOT_PASSWORD=Qwerty123
